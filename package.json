{
  "name": "knoww-monorepo",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev:web": "pnpm --filter @knoww/web dev",
    "dev:ext": "pnpm --filter @knoww/extension dev",
    "build:web": "pnpm --filter @knoww/web build",
    "build:ext": "pnpm --filter @knoww/extension build",
    "build:mcp": "pnpm --filter @knoww/mcp build",
    "build:ext:dev": "pnpm --filter @knoww/extension build:dev",
    "release:ext": "pnpm --filter @knoww/extension run release",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present run test",
    "preview": "pnpm --filter @knoww/web preview",
    "deploy": "pnpm --filter @knoww/web run deploy",
    "lint": "biome check",
    "lint:ext": "pnpm --filter @knoww/extension lint",
    "lint:web": "pnpm --filter @knoww/web lint",
    "format": "biome format --write",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:ext": "pnpm --filter @knoww/extension typecheck",
    "typecheck:web": "pnpm --filter @knoww/web typecheck",
    "check:mcp-bindings": "pnpm --filter @knoww/mcp cf-typegen && git diff --exit-code -- apps/mcp/cloudflare-env.d.ts",
    "verify:mcp": "pnpm check:mcp-bindings && pnpm build:mcp",
    "audit:security": "pnpm audit --audit-level=high",
    "brand:render": "node tooling/brand/render-k-mark.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "husky": "9.1.7",
    "sharp": "^0.35.3",
    "typescript": "catalog:"
  }
}
