{
  "name": "@knoww/extension",
  "version": "2.5.33",
  "private": true,
  "scripts": {
    "build": "webpack --mode production && node scripts/assert-production-bundle.mjs",
    "dev": "webpack --mode development --watch",
    "clean": "rm -rf dist",
    "test": "pnpm run test:scoring",
    "test:scoring": "rm -rf .test-dist && tsc -p tsconfig.tests.json && node --test .test-dist/apps/extension/tests/**/*.test.js",
    "benchmark:embeddings": "node scripts/benchmark-embeddings.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "version:bump": "node scripts/bump-version.mjs",
    "zip": "rm -f knoww-extension.zip && cd dist && zip -r ../knoww-extension.zip . -x '.*' '*.LICENSE.txt'",
    "release": "node scripts/bump-version.mjs && pnpm run build && pnpm run zip"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@knoww/logger": "workspace:*",
    "@knoww/shared-types": "workspace:*",
    "@polymarket/clob-client-v2": "catalog:",
    "@walletconnect/universal-provider": "2.23.9",
    "decimal.js": "catalog:",
    "minisearch": "7.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-qr-code": "catalog:",
    "viem": "catalog:",
    "wink-eng-lite-web-model": "1.8.1",
    "wink-nlp": "2.4.0"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@types/chrome": "0.1.40",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "buffer": "6.0.3",
    "copy-webpack-plugin": "14.0.0",
    "dotenv": "17.4.2",
    "process": "0.11.10",
    "ts-loader": "9.5.7",
    "typescript": "catalog:",
    "webpack": "5.106.2",
    "webpack-cli": "7.0.2"
  }
}
