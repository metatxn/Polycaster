{
  "name": "@knoww/web",
  "version": "0.1.2",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-network-family-autoselection\" next dev --port 8000",
    "dev:turbo": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--no-network-family-autoselection\" next dev --turbopack --port 8000",
    "build": "next build && node scripts/check-route-css.mjs",
    "css:report": "node scripts/check-route-css.mjs",
    "start": "next start",
    "soak": "node scripts/soak-memory.mjs",
    "soak:assert": "SOAK_ASSERT=1 node scripts/soak-memory.mjs",
    "indexnow": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/submit-indexnow.mts",
    "lint": "biome check",
    "format": "biome format --write",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "agent:d1:list:local": "wrangler d1 migrations list knoww-agent-paper --local --config wrangler.jsonc",
    "agent:d1:adopt-runtime-schema:local": "wrangler d1 execute knoww-agent-paper --local --file ../agent/adoption/adopt-runtime-schema.sql --config wrangler.jsonc",
    "agent:d1:adopt-runtime-schema:remote": "wrangler d1 execute knoww-agent-paper --remote --file ../agent/adoption/adopt-runtime-schema.sql --config wrangler.jsonc",
    "agent:d1:migrate:local": "wrangler d1 migrations apply knoww-agent-paper --local --config wrangler.jsonc",
    "agent:d1:migrate:remote": "wrangler d1 migrations apply knoww-agent-paper --remote --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm run test:node",
    "test:node": "node --experimental-strip-types --test $(find src -name '*.test.mjs')",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.3.7",
    "@knoww/agent": "workspace:*",
    "@knoww/logger": "workspace:*",
    "@knoww/services": "workspace:*",
    "@knoww/shared-types": "workspace:*",
    "@metamask/connect-evm": "2.1.1",
    "@noble/hashes": "^2.3.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@openrouter/ai-sdk-provider": "2.10.0",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@reown/appkit": "1.8.23",
    "@reown/appkit-adapter-wagmi": "1.8.23",
    "@tanstack/react-query": "5.101.4",
    "@wagmi/connectors": "8.1.0",
    "@walletconnect/ethereum-provider": "2.23.10",
    "accounts": "0.14.11",
    "ai": "6.0.239",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "decimal.js": "catalog:",
    "framer-motion": "12.43.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "1.31.0",
    "next": "15.5.22",
    "next-themes": "0.4.6",
    "posthog-js": "1.417.1",
    "posthog-node": "5.49.1",
    "react": "catalog:",
    "react-day-picker": "10.0.1",
    "react-dom": "catalog:",
    "react-qr-code": "catalog:",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "viem": "catalog:",
    "virtua": "0.50.1",
    "wagmi": "3.7.6",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query-devtools": "5.101.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "26.2.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^30.0.0",
    "pino-pretty": "13.1.3",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "catalog:",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  }
}
