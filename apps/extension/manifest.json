{
  "manifest_version": 3,
  "name": "Knoww - Prediction Markets for Social Media",
  "version": "2.5.21",
  "description": "Discover and navigate prediction markets",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Knoww Settings"
  },
  "permissions": ["storage", "offscreen", "scripting"],
  "host_permissions": [
    "https://knoww.app/*",
    "https://gamma-api.polymarket.com/*",
    "https://clob.polymarket.com/*",
    "https://bridge.polymarket.com/*",
    "https://relayer-v2.polymarket.com/*",
    "https://polygon-bor-rpc.publicnode.com/*",
    "https://api.elections.kalshi.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-16.png",
        "icons/icon-32.png",
        "icons/icon-48.png",
        "icons/icon-128.png",
        "icons/icon-256.png",
        "knoww-inline.css",
        "page-bridge.js",
        "*.wasm",
        "*.mjs"
      ],
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://www.linkedin.com/*",
        "https://reddit.com/*",
        "https://*.reddit.com/*",
        "https://quora.com/*",
        "https://*.quora.com/*",
        "https://news.ycombinator.com/*",
        "https://stackoverflow.com/*",
        "https://*.stackoverflow.com/*",
        "https://*.stackexchange.com/*",
        "https://superuser.com/*",
        "https://*.superuser.com/*",
        "https://serverfault.com/*",
        "https://*.serverfault.com/*",
        "https://askubuntu.com/*",
        "https://*.askubuntu.com/*",
        "https://mathoverflow.net/*",
        "https://*.mathoverflow.net/*",
        "https://stackapps.com/*",
        "https://*.stackapps.com/*",
        "https://producthunt.com/*",
        "https://*.producthunt.com/*",
        "https://slashdot.org/*",
        "https://*.slashdot.org/*",
        "https://lemmy.world/*",
        "https://lemmy.ml/*",
        "https://sh.itjust.works/*",
        "https://programming.dev/*",
        "https://beehaw.org/*",
        "https://feddit.org/*",
        "https://lemm.ee/*",
        "https://threads.com/*",
        "https://*.threads.com/*",
        "https://bsky.app/*",
        "https://*.bsky.app/*",
        "https://mastodon.social/*",
        "https://mstdn.social/*",
        "https://fosstodon.org/*",
        "https://hachyderm.io/*",
        "https://mas.to/*",
        "https://infosec.exchange/*",
        "https://discord.com/*",
        "https://*.discord.com/*",
        "https://farcaster.xyz/*",
        "https://*.farcaster.xyz/*",
        "https://coinmarketcap.com/*",
        "https://*.coinmarketcap.com/*",
        "https://paragraph.com/*",
        "https://*.paragraph.com/*",
        "https://coindesk.com/*",
        "https://*.coindesk.com/*",
        "https://cointelegraph.com/*",
        "https://*.cointelegraph.com/*",
        "https://decrypt.co/*",
        "https://*.decrypt.co/*",
        "https://theblock.co/*",
        "https://*.theblock.co/*",
        "https://blockworks.com/*",
        "https://*.blockworks.com/*",
        "https://bankless.com/*",
        "https://*.bankless.com/*",
        "https://bitcoinmagazine.com/*",
        "https://*.bitcoinmagazine.com/*",
        "https://beincrypto.com/*",
        "https://*.beincrypto.com/*",
        "https://unchainedcrypto.com/*",
        "https://*.unchainedcrypto.com/*",
        "https://cryptopanic.com/*",
        "https://*.cryptopanic.com/*"
      ]
    }
  ],
  "options_page": "options.html"
}
