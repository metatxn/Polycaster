#!/bin/sh

# Fix PATH for GUI clients (like Cursor/VS Code)
export PATH="$HOME/Library/pnpm:$HOME/.nvm/versions/node/v23.4.0/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Load NVM if it exists
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  \. "$HOME/.nvm/nvm.sh"
fi

echo "🔍 Running pre-commit checks..."

# Run linting
echo "📋 Checking linting..."
pnpm lint
if [ $? -ne 0 ]; then
  echo "❌ Linting failed. Please fix the errors before committing."
  exit 1
fi
echo "✅ Linting passed!"

# Run formatting check
echo "🎨 Checking formatting..."
pnpm format
if [ $? -ne 0 ]; then
  echo "❌ Formatting failed. Please fix the errors before committing."
  exit 1
fi
echo "✅ Formatting passed!"

echo "🎉 Pre-commit checks passed! Proceeding with commit..."
echo "💡 Note: Build check will run before push."
