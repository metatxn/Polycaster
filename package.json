{
  "name": "knoww-monorepo",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @knoww/web dev",
    "dev:ext": "pnpm --filter @knoww/extension dev",
    "build:web": "pnpm --filter @knoww/web build",
    "build:ext": "pnpm --filter @knoww/extension build",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @knoww/web preview",
    "deploy": "pnpm --filter @knoww/web run deploy",
    "lint": "biome check",
    "lint:ext": "pnpm --filter @knoww/extension lint",
    "lint:web": "pnpm --filter @knoww/web lint",
    "format": "biome format --write",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:ext": "pnpm --filter @knoww/extension typecheck",
    "typecheck:web": "pnpm --filter @knoww/web typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "husky": "^9.1.7",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.13.5",
      "@isaacs/brace-expansion": "^5.0.1",
      "fast-xml-parser": "^5.5.7",
      "qs": "^6.14.1",
      "body-parser": "^2.2.1",
      "h3": "1.15.10",
      "hono": "4.12.7",
      "minimatch": "10.2.3",
      "lodash": "4.17.23",
      "bn.js": "4.12.3",
      "@polymarket/builder-signing-sdk": "1.0.0",
      "undici": "7.24.0",
      "socket.io-parser": "4.2.6"
    }
  }
}
