# Polymarket V2 builder attribution code (bytes32 hex string).
# Public identifier — not a secret. Exposed to browser bundle.
#
# Keep this value IDENTICAL across web, agent, and extension. Only the variable
# name differs by surface — Next.js inlines client-side vars only when they are
# prefixed, so the trading hooks need NEXT_PUBLIC_, while the extension and
# agent use the bare POLY_BUILDER_CODE. Polymarket looks up the builder taker
# fee rate per code, so a mismatch means the same trade is charged a different
# fee depending on which surface placed it.
#
# Server-side routes read POLY_BUILDER_CODE first and fall back to this one, so
# setting only NEXT_PUBLIC_ is enough here.
NEXT_PUBLIC_POLY_BUILDER_CODE=

# Polymarket CLOB host. Override to https://clob-v2.polymarket.com for preprod.
NEXT_PUBLIC_POLYMARKET_HOST=https://clob.polymarket.com
# Polymarket CLOB WebSocket base host (no path). Per V2 migration docs
# WebSocket URLs are unchanged at cutover. Override only if Polymarket provides
# a preprod WS host (e.g. wss://ws-subscriptions-clob-v2.polymarket.com).
NEXT_PUBLIC_POLYMARKET_WS_HOST=wss://ws-subscriptions-clob.polymarket.com
NEXT_PUBLIC_POLYMARKET_CHAIN_ID=137

# Polymarket V2 Relayer API Key — server-side secret.
# Obtain from https://polymarket.com/settings?tab=builder → "Relayer API Keys".
# Used by /api/relayer/[...path] to authenticate to Polymarket's relayer.
POLY_RELAYER_API_KEY=
POLY_RELAYER_API_KEY_ADDRESS=
