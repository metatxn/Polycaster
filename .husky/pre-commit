#!/bin/sh

# Use the same Node.js major version as CI and production builds.
. "$(dirname "$0")/use-node-24.sh"

echo "🔍 Running pre-commit checks..."

# Run linting
echo "📋 Checking linting..."
pnpm lint
if [ $? -ne 0 ]; then
  echo "❌ Linting failed. Please fix the errors before committing."
  exit 1
fi
echo "✅ Linting passed!"

# Ensure Wrangler configuration and committed Worker bindings agree.
echo "🔗 Checking generated MCP Worker bindings..."
pnpm check:mcp-bindings
if [ $? -ne 0 ]; then
  echo "❌ MCP Worker bindings are stale. Stage apps/mcp/cloudflare-env.d.ts and retry."
  exit 1
fi
echo "✅ MCP Worker bindings are current!"

# Run formatting check
echo "🎨 Checking formatting..."
pnpm format
if [ $? -ne 0 ]; then
  echo "❌ Formatting failed. Please fix the errors before committing."
  exit 1
fi
echo "✅ Formatting passed!"

echo "🎉 Pre-commit checks passed! Proceeding with commit..."
echo "💡 Note: Build check will run before push."
