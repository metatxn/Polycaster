{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["chrome"],
    "sourceMap": false,
    "paths": {
      "@knoww/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@knoww/shared-types/*": ["../../packages/shared-types/src/*"]
    }
  },
  "include": [
    "src/background/unified-clob-client.ts",
    "src/background/clob-credentials-store.ts",
    "src/background/extension-session-token.ts",
    "src/background/portfolio-fund-idempotency.ts",
    "src/background/portfolio-withdraw-flow.ts",
    "src/background/trading-credential-mediation.ts",
    "src/background/usd-format.ts",
    "src/content/scoring-policy.ts",
    "src/content/notification-surface.ts",
    "src/background/score-markets-core.ts",
    "src/types/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
