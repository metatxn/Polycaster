# HMAC secret shared with the knoww.app backend.
# Generate with: openssl rand -hex 32
# Must match KNOWW_EXTENSION_SECRET on the polycaster backend.
KNOWW_EXTENSION_SECRET=

# Set to "true" to use localhost:8787 instead of https://knoww.app
# for API calls (extract-topics, sign, validate-relevance, etc.)
DEV_MODE=false
