      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Frontend + extension surfaces\n\n• Web pages in `apps/web/src/app/*`\n• Content runtime in `apps/extension/src/content/*`\n• Wallet bridge in `apps/extension/src/page-bridge.ts`\n• Session + local runtime state in browser storage",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Frontend + extension surfaces\n\n• Web pages in `apps/web/src/app/*`\n• Content runtime in `apps/extension/src/content/*`\n• Wallet bridge in `apps/extension/src/page-bridge.ts`\n• Session + local runtime state in browser storage",
      "autoResize": true,
      "lineHeight": 1.25
    },
