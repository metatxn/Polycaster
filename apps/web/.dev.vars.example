# Load .env.development* files when running `wrangler dev`.
NEXTJS_ENV=development
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="d852b3fd3322f8194d78fbea25c92711"

# Paper-trading agent admin token. Use a local-only random value.
AGENT_ADMIN_TOKEN=

# OpenRouter key used by apps/agent/src/llm-panel.ts.
OPENROUTER_API_KEY=
OPENROUTER_APP_NAME=Knoww
OPENROUTER_APP_URL=https://knoww.app

# Optional comma-separated list. Keep three independent model families.
AGENT_LLM_MODELS=google/gemini-3-flash-preview,anthropic/claude-sonnet-4.5,openai/gpt-5.4-mini
AGENT_LLM_TIMEOUT_MS=25000
AGENT_LLM_SPACING_MS=1500

# Blocks new paper decisions when a market is closed or close to closing.
AGENT_MARKET_CLOSE_BUFFER_MS=30000
