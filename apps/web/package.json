{
  "name": "@knoww/web",
  "version": "0.1.2",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "next dev --port 8000",
    "dev:turbo": "next dev --turbopack --port 8000",
    "build": "next build",
    "start": "next start",
    "soak": "node scripts/soak-memory.mjs",
    "soak:assert": "SOAK_ASSERT=1 node scripts/soak-memory.mjs",
    "lint": "biome check",
    "format": "biome format --write",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "agent:d1:list:local": "wrangler d1 migrations list knoww-agent-paper --local --config wrangler.jsonc",
    "agent:d1:migrate:local": "wrangler d1 migrations apply knoww-agent-paper --local --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm run test:node",
    "test:node": "node --test $(find src -name '*.test.mjs')",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "4.3.7",
    "@knoww/agent": "workspace:*",
    "@knoww/logger": "workspace:*",
    "@knoww/shared-types": "workspace:*",
    "@metamask/connect-evm": "2.1.0",
    "@noble/hashes": "^2.2.0",
    "@opennextjs/cloudflare": "1.19.11",
    "@openrouter/ai-sdk-provider": "2.9.1",
    "@radix-ui/react-avatar": "1.2.0",
    "@radix-ui/react-collapsible": "1.1.14",
    "@radix-ui/react-dialog": "1.1.17",
    "@radix-ui/react-dropdown-menu": "2.1.18",
    "@radix-ui/react-popover": "1.1.17",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-switch": "1.3.1",
    "@radix-ui/react-tabs": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.10",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@reown/appkit": "1.8.21",
    "@reown/appkit-adapter-wagmi": "1.8.21",
    "@tanstack/react-query": "5.101.0",
    "@walletconnect/ethereum-provider": "2.23.9",
    "accounts": "0.14.11",
    "ai": "6.0.208",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "decimal.js": "catalog:",
    "framer-motion": "12.40.0",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "1.21.0",
    "next": "15.5.19",
    "next-themes": "0.4.6",
    "porto": "0.2.37",
    "posthog-js": "1.391.7",
    "posthog-node": "5.38.2",
    "react": "catalog:",
    "react-day-picker": "10.0.1",
    "react-dom": "catalog:",
    "react-qr-code": "catalog:",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "viem": "catalog:",
    "virtua": "0.49.1",
    "wagmi": "3.6.17",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "4.3.1",
    "@tanstack/react-query-devtools": "5.101.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.0.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "4.1.9",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "13.1.3",
    "playwright": "1.61.0",
    "tailwindcss": "4.3.1",
    "tw-animate-css": "1.4.0",
    "typescript": "catalog:",
    "vitest": "^4.1.9",
    "wrangler": "4.103.0"
  }
}
