{
  "name": "@knoww/extension",
  "version": "2.5.49",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:prod",
    "build:dev": "webpack --config webpack.config.cjs --mode development",
    "build:prod": "webpack --config webpack.config.cjs --mode production && node scripts/assert-production-bundle.mjs && node scripts/smoke-esm-modules.mjs",
    "dev": "webpack --config webpack.config.cjs --mode development --watch",
    "clean": "rm -rf dist",
    "test": "pnpm run test:scoring",
    "test:scoring": "vitest run --config vitest.config.ts",
    "benchmark:embeddings": "node scripts/benchmark-embeddings.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "version:bump": "node scripts/bump-version.mjs",
    "zip": "rm -f knoww-extension.zip && cd dist && zip -r ../knoww-extension.zip . -x '.*' '.stats/*' '*.LICENSE.txt'",
    "release": "node scripts/bump-version.mjs && pnpm run build && pnpm run zip"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@knoww/logger": "workspace:*",
    "@knoww/shared-types": "workspace:*",
    "@walletconnect/universal-provider": "2.23.10",
    "decimal.js": "catalog:",
    "minisearch": "7.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-qr-code": "catalog:",
    "viem": "catalog:",
    "wink-eng-lite-web-model": "1.8.1",
    "wink-nlp": "2.4.0"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@types/chrome": "0.2.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "buffer": "6.0.3",
    "copy-webpack-plugin": "14.0.0",
    "dotenv": "17.4.2",
    "process": "0.11.10",
    "ts-loader": "9.6.2",
    "typescript": "catalog:",
    "vite": "8.1.2",
    "vitest": "^4.1.9",
    "webpack": "5.108.3",
    "webpack-cli": "7.1.0"
  }
}
