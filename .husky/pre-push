#!/bin/sh

# Fix PATH for GUI clients (like Cursor/VS Code)
export PATH="$HOME/Library/pnpm:$HOME/.nvm/versions/node/v23.4.0/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Load NVM if it exists
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  \. "$HOME/.nvm/nvm.sh"
fi

echo "Running pre-push checks..."

echo "Type-checking all packages..."
pnpm typecheck
if [ $? -ne 0 ]; then
  echo "TypeScript check failed. Please fix type errors before pushing."
  exit 1
fi
echo "TypeScript check passed!"

echo "Running linter..."
pnpm lint --diagnostic-level=error
if [ $? -ne 0 ]; then
  echo "Lint check failed. Please fix lint errors before pushing."
  exit 1
fi
echo "Lint check passed!"

echo "Building web app..."
pnpm build:web
if [ $? -ne 0 ]; then
  echo "Web build failed. Please fix the errors before pushing."
  exit 1
fi
echo "Web build passed!"

echo "Building extension..."
pnpm build:ext
if [ $? -ne 0 ]; then
  echo "Extension build failed. Please fix the errors before pushing."
  exit 1
fi
echo "Extension build passed!"

echo "Pre-push checks passed! Proceeding with push..."
